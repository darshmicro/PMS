<?xml version="1.0" encoding="utf-8"?>
<!--
    Place this file at the site root IIS serves (e.g. D:\PMS\pms_app\web.config).
    Requires the "HttpPlatformHandler" IIS module (see DEPLOYMENT.md step 5).
    IIS starts/stops/monitors the uvicorn process itself and reverse-proxies
    every request to it on 127.0.0.1:%HTTP_PLATFORM_PORT% (IIS assigns a
    free port to that token automatically).
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="D:\PMS\pms_app\venv\Scripts\python.exe"
                   arguments="-m uvicorn app.main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT%"
                   workingDirectory="D:\PMS\pms_app"
                   startupTimeLimit="60"
                   startupRetryCount="3"
                   stdoutLogEnabled="true"
                   stdoutLogFile="D:\PMS\logs\pms-stdout.log">
      <environmentVariables>
        <!-- Only non-secret, environment-identifying variables belong here.
             Real secrets (SESSION_SECRET_KEY, DB_PASSWORD, AD_BIND_PASSWORD)
             live in D:\PMS\pms_app\.env, which python-dotenv loads at
             startup - never paste them into web.config, which is often
             readable by more people/tools than the .env file's own ACL. -->
        <environmentVariable name="ENVIRONMENT" value="production" />
      </environmentVariables>
    </httpPlatform>

    <!-- Windows Integrated Authentication is configured at the IIS site
         level (IIS Manager > Authentication), not here - see DEPLOYMENT.md
         step 6. Once enabled, IIS forwards the authenticated identity as
         the header named by IIS_FORWARDED_USER_HEADER in .env
         (X-Remote-User by default) - most environments need a URL Rewrite
         "Set HTTP Response/Request Header" inbound rule, or a small ISAPI/
         ARR helper, to translate IIS's own auth into that header; see the
         note in DEPLOYMENT.md if your IIS version does not do this natively. -->

    <security>
      <requestFiltering>
        <!-- Matches MAX_UPLOAD_SIZE_MB=25 in .env.example - keep these in sync. -->
        <requestLimits maxAllowedContentLength="26214400" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
