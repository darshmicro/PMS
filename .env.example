# Copy this file to .env and fill in real values before starting the app.
# Every value here maps 1:1 to a field on Settings (app/core/config.py).
# NEVER commit the real .env file - it holds credentials.

# ---- Application ----
APP_NAME=Performance Management System
# Long, random, unique per environment - signs session cookies (app/core/session.py).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=
SESSION_TIMEOUT_MINUTES=30
# development | production - production forces the session cookie's Secure flag on.
ENVIRONMENT=production

# ---- Database (SQL Server) ----
DB_SERVER=sqlserver.company.local
DB_PORT=1433
DB_NAME=PMS_DB
# sql | windows - windows uses the app pool's Windows identity (trusted connection),
# no DB_USER/DB_PASSWORD needed; sql uses SQL auth with the credentials below.
DB_AUTH_MODE=sql
DB_USER=pms_app_svc
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
# no | yes - ODBC Driver 18 validates the server's TLS certificate by default.
# Leave this "no" in production (use a properly CA-issued certificate on SQL
# Server instead of weakening this check). Only set to "yes" for a local/demo
# SQL Server Express instance whose self-signed certificate isn't in any
# trust store - see DEPLOY_WINDOWS11_HOME_DEMO.md.
DB_TRUST_SERVER_CERTIFICATE=no

# ---- Authentication mode ----
# iis_forwarded: IIS/Windows Integrated Auth has already authenticated the
#   user; this app trusts the header IIS forwards. AD users only.
# ldap_bind: the app itself binds to AD with a submitted username/password,
#   no IIS needed. AD users only.
# hybrid: RECOMMENDED for most company-network installs, including ones
#   that need to support a few non-AD/local accounts (contractors, service
#   accounts, or just not having AD reachable from every machine) alongside
#   normal AD logins. Every login is checked against the app's own local
#   account table first and falls through to an AD bind only if no local
#   account matches - one login screen, both kinds of users. Safe in
#   production. See DEPLOYMENT.md's "Hybrid (AD + local users)" section.
# demo_local: local-accounts-only, zero AD dependency. Refused outright
#   whenever ENVIRONMENT=production - this is only for the AD-less Windows
#   11 Home demo path, see DEPLOY_WINDOWS11_HOME_DEMO.md. Use "hybrid"
#   instead for any real deployment that needs local accounts.
AUTH_MODE=iis_forwarded
IIS_FORWARDED_USER_HEADER=X-Remote-User

# ---- Active Directory ----
AD_SERVER=dc01.company.local
AD_DOMAIN=COMPANY
AD_USE_SSL=true
AD_PORT=636
# Only needed if the app itself binds to AD (ldap_bind mode, or to resolve
# AD group membership) - a low-privilege service account, read-only.
AD_BIND_DN=
AD_BIND_PASSWORD=
AD_BASE_DN=DC=company,DC=local

# ---- File storage / email (M22/M23) ----
# Absolute path on the app server (or a UNC/mapped drive) where uploaded
# evidence/attachments are stored. Must be writable by the app pool identity.
FILE_STORAGE_PATH=D:\PMS\storage\attachments
MAX_UPLOAD_SIZE_MB=25
SMTP_SERVER=smtp.company.local
SMTP_PORT=25
SMTP_FROM=pms-noreply@company.com
